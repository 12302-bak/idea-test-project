<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="_framework.mybatis.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="_framework.mybatis.bean.User" >
        <result column="name" property="name" />
        <result column="age" property="age" />
        <result column="account" property="account" />
        <result column="password" property="password" />
        <result column="time" property="time" />
    </resultMap>

    <sql id="Base_Column_List">
        name,
        age,
        account,
        password,
        time
    </sql>

    <select id="selectByName" parameterType="java.lang.String" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"></include>
        from user where name = #{name}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyColumn="id" keyProperty="id" parameterType="_framework.mybatis.bean.User">
        INSERT INTO user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="null != name and '' != name">
                name,
            </if>
            <if test="null != age ">
                age,
            </if>
            <if test="null != account and '' != account">
                account,
            </if>
            <if test="null != password and '' != password">
                password,
            </if>
            <if test="null != time ">
                time
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="null != name and '' != name">
                #{name},
            </if>
            <if test="null != age ">
                #{age},
            </if>
            <if test="null != account and '' != account">
                #{account},
            </if>
            <if test="null != password and '' != password">
                #{password},
            </if>
            <if test="null != time ">
                #{time}
            </if>
        </trim>
    </insert>

    <delete id="delete" >
        DELETE FROM user
        WHERE id = #{id}
    </delete>

    <update id="update" parameterType="_framework.mybatis.bean.User">
        UPDATE user
        <set>
            <if test="null != name and '' != name">name = #{name},</if>
            <if test="null != age ">age = #{age},</if>
            <if test="null != account and '' != account">account = #{account},</if>
            <if test="null != password and '' != password">password = #{password},</if>
            <if test="null != time ">time = #{time}</if>
        </set>
        WHERE id = #{id}
    </update>


    <select id="load" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
        WHERE id = #{id}
    </select>

    <select id="pageList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM user
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="pageListCount" resultType="java.lang.Integer">
        SELECT count(1)
        FROM user
    </select>

</mapper>